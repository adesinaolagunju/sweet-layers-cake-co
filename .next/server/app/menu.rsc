erload","name":"Chocolate Overload","description":"Triple cocoa cake, fudge filling, chocolate buttercream, and chocolate shards. No regrets.","sizeOptions":[{"label":"6-inch round","servings":"Serves 10–12","priceFrom":70},{"label":"8-inch round","servings":"Serves 20–24","priceFrom":100},{"label":"10-inch round","servings":"Serves 30–38","priceFrom":140}],"startingPrice":70},{"id":"strawberry-bliss","name":"Strawberry Bliss","description":"Golden sponge with fresh strawberry compote and mascarpone whipped frosting.","sizeOptions":[{"label":"6-inch round","servings":"Serves 10–12","priceFrom":75},{"label":"8-inch round","servings":"Serves 20–24","priceFrom":105},{"label":"10-inch round","servings":"Serves 30–38","priceFrom":145}],"startingPrice":75},{"id":"salted-caramel-espresso","name":"Salted Caramel Espresso","description":"Espresso-soaked chocolate layers, salted caramel filling, and espresso ganache.","sizeOptions":[{"label":"6-inch round","servings":"Serves 10–12","priceFrom":80},{"label":"8-inch round","servings":"Serves 20–24","priceFrom":115},{"label":"10-inch round","servings":"Serves 30–38","priceFrom":155}],"startingPrice":80},{"id":"lemon-blueberry-sunrise-menu","name":"Lemon Blueberry Sunrise","description":"Zesty lemon curd and wild blueberry layers under pale lemon buttercream clouds.","sizeOptions":[{"label":"6-inch round","servings":"Serves 10–12","priceFrom":75},{"label":"8-inch round","servings":"Serves 20–24","priceFrom":105},{"label":"10-inch round","servings":"Serves 30–38","priceFrom":145}],"startingPrice":75}]},{"id":"wedding","name":"Wedding & Tiered Cakes","description":"Fully custom tiers for the biggest yes of your life. Every booking includes a tasting box, design consultation, delivery, and setup.","items":[{"id":"timeless-ivory-tiers","name":"Timeless Ivory Tiers","description":"Smooth ivory buttercream with delicate piping — the classic white wedding cake, perfected.","sizeOptions":[{"label":"Two-tier","servings":"Serves 40–50","priceFrom":450},{"label":"Three-tier","servings":"Serves 75–90","priceFrom":750},{"label":"Four-tier","servings":"Serves 110–130","priceFrom":1050}],"startingPrice":450,"popular":true},{"id":"garden-romance-tiers","name":"Garden Romance Tiers","description":"Fresh florals and pressed botanicals over lemon elderflower or vanilla bean layers.","sizeOptions":[{"label":"Two-tier","servings":"Serves 40–50","priceFrom":480},{"label":"Three-tier","servings":"Serves 75–90","priceFrom":790},{"label":"Four-tier","servings":"Serves 110–130","priceFrom":1090}],"startingPrice":480},{"id":"modern-metallic-tiers","name":"Modern Metallic Tiers","description":"Brushed gold or rose-gold accents on sleek textured buttercream for contemporary celebrations.","sizeOptions":[{"label":"Two-tier","servings":"Serves 40–50","priceFrom":500},{"label":"Three-tier","servings":"Serves 75–90","priceFrom":820},{"label":"Four-tier","servings":"Serves 110–130","priceFrom":1120}],"startingPrice":500}]},{"id":"custom","name":"Custom & Novelty","description":"Sculpted, painted, and one-of-a-kind creations. Share your idea — wilder is welcome.","items":[{"id":"fully-bespoke-design","name":"Fully Bespoke Design","description":"A one-of-a-kind sculpted cake designed with you from sketch to slice. Final quote follows your free consultation.","sizeOptions":[{"label":"Single-tier sculpted","servings":"Serves 15–20","priceFrom":180},{"label":"Two-tier sculpted","servings":"Serves 35–45","priceFrom":380},{"label":"Showstopper (3+ tiers)","servings":"Serves 60+","priceFrom":650}],"startingPrice":180},{"id":"photo-print-cake","name":"Photo Print Cake","description":"Your favourite photo printed in edible ink over smooth fondant — portraits, pets, places, memes welcome.","sizeOptions":[{"label":"6-inch round","servings":"Serves 10–12","priceFrom":85},{"label":"8-inch round","servings":"Serves 20–24","priceFrom":110},{"label":"10-inch round","servings":"Serves 30–38","priceFrom":150}],"startingPrice":85},{"id":"novel